<Application 
	xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:semi="https://irihi.tech/semi"
	xmlns:conv="using:FlomtManager.MemoryReader.Converters"
    x:Class="FlomtManager.MemoryReader.App"
    xmlns:local="using:FlomtManager.MemoryReader"
	RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
		<semi:SemiTheme Locale="en-US" />
		<StyleInclude Source="/Styles/Styles.axaml" />
	</Application.Styles>

	<Application.Resources>
		<conv:EqualsConverter x:Key="EqualsConverter" />
	</Application.Resources>
</Application>